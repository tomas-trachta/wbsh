=== 1. strict-mode header: -o inside a cluster takes the next word
args=0
set -o errexit
set -o nounset
set -o pipefail
rc=1
=== 2. each o in a cluster takes one word, in order
set -o errexit
set +o nounset
set -o pipefail
n=2 1=x
set -o errexit
set -o nounset
set -o pipefail
=== 3. +o in a cluster
set +o errexit
set +o nounset
set +o pipefail
=== 4. set -o / set +o without a name list the options
allexport      	off
braceexpand    	on
emacs          	off
errexit        	off
errtrace       	off
functrace      	off
hashall        	on
histexpand     	off
history        	off
ignoreeof      	off
