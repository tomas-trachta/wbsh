=== 11. vi and emacs exclude each other
set +o emacs
set -o vi
set -o emacs
set +o vi
=== 12. -v / verbose echoes input lines as they are read
# a comment line
echo a; echo b
a
b
if true; then
	echo in-if
fi
in-if
cat <<E
heredoc body
E
heredoc body
eval 'echo from-eval'
echo from-eval
from-eval
x=$(echo not-echoed)
. ./_verbose_src.sh
echo sourced
sourced
set +v
quiet
