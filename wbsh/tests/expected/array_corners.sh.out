=== negative subscripts
1 2 3 last
1x 2 3 last
1x 2 last / 0 1 3
too negative rc=1
=== appending a list to a scalar
declare -a s=([0]="str" [1]="arr" [2]="more")
=== unset of a whole array
b[@]: 0 declared=yes
c[*]: 0 declared=yes
=== arithmetic subscripts with spaces
d c a
=== read into elements
[val ue]
declare -a n=([2]="two")
=== declare -p quoting
declare -a q=([0]="1" [1]="two words" [2]=$'tab\there' [3]=$'nl\nx' [4]="dq\"\$")
declare -- r=$'a\001b'
declare -A h=([k]=$'v\tw' )
declare -a e
=== mapfile -d
[x][y][z]
declare -a kept=([0]="x:" [1]="y:")
declare -a nul=([0]="a" [1]="b c")
declare -a raw=([0]="a" [1]="b")
=== anchored empty patterns
[<apple][<][<cherry][apple>][>][cherry>]
[^a b][^c][a b$ c$]
<xyz xyz> xyz []
