=== the spec of the command after a separator is used
[make && sw main ][]
[make; sw main ][]
[cat x | sw main ][]
[(sw main ][]
[{ sw main ][]
[true || sw other ][]
=== the completion function sees only the current command
LINE=[foo ab] POINT=6 CWORD=1 WORDS=[foo ab] ARGS=[foo|ab|foo]
[make && foo ab][]
LINE=[foo ] POINT=4 CWORD=1 WORDS=[foo ] ARGS=[foo||foo]
[foo ][]
LINE=[foo a b] POINT=7 CWORD=2 WORDS=[foo a b] ARGS=[foo|b|a]
[echo hi; foo a b][]
LINE=[foo ab cd] POINT=6 CWORD=1 WORDS=[foo ab cd] ARGS=[foo|ab|foo]
[make && foo ab][ cd; ls]
LINE=[foo ab cd] POINT=5 CWORD=1 WORDS=[foo ab cd] ARGS=[foo|a|foo]
[foo a][b cd; ls]
=== quotes and expansions stay one word and hide separators
LINE=[foo "a b" c] POINT=11 CWORD=2 WORDS=[foo "a b" c] ARGS=[foo|c|"a b"]
[foo "a b" c][]
LINE=[foo "x;y" c] POINT=11 CWORD=2 WORDS=[foo "x;y" c] ARGS=[foo|c|"x;y"]
[foo "x;y" c][]
LINE=[foo 'a|b' c] POINT=11 CWORD=2 WORDS=[foo 'a|b' c] ARGS=[foo|c|'a|b']
[foo 'a|b' c][]
LINE=[foo $(echo x; echo y) ] POINT=22 CWORD=2 WORDS=[foo $(echo x; echo y) ] ARGS=[foo||$(echo x; echo y)]
[foo $(echo x; echo y) ][]
LINE=[foo ${x} z] POINT=10 CWORD=2 WORDS=[foo ${x} z] ARGS=[foo|z|${x}]
[foo ${x} z][]
=== a redirection's & does not start a command; assignments are skipped
LINE=[foo 2>&1 a] POINT=10 CWORD=2 WORDS=[foo 2>&1 a] ARGS=[foo|a|2>&1]
[foo 2>&1 a][]
LINE=[foo a] POINT=5 CWORD=1 WORDS=[foo a] ARGS=[foo|a|foo]
[X=1 Y[2]=3 foo a][]
LINE=[foo a] POINT=5 CWORD=1 WORDS=[foo a] ARGS=[foo|a|foo]
[ls; X=1 foo a][]
=== the first word of a command still completes as a command
[true && __lineedit ][]
[X=1 __lineedit ][]
