=== 6. default operators
-- none
n=1 [d]
n=1 [d]
n=0
n=0
-- one empty
n=1 [d]
n=1 []
n=1 []
n=0
-- two empty
n=2 [] []
n=2 [] []
n=1 [x y]
n=2 [x] [y]
-- two
n=2 [a b] [c]
n=2 [a b] [c]
n=1 [x y]
n=2 [x] [y]
n=1 [d]
