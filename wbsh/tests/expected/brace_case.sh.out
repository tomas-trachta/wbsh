anything else
=== 10. quoted and escaped pattern characters match literally
  escaped      ab -> no
  single       ab -> no
  double       ab -> no
  var-quoted   ab -> no
  var-unquoted ab -> glob
  backslash literal
  bracket literal
  dash in class literal
  quoted prefix + glob
