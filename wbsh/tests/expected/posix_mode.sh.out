=== what set -o posix turns on
echo "POSIXLY_CORRECT=$POSIXLY_CORRECT"; shopt -p expand_aliases inherit_errexit shift_verbose
  => POSIXLY_CORRECT=y | shopt -s expand_aliases | shopt -s inherit_errexit | shopt -s shift_verbose |   reached, status 0
set +o posix; echo "${POSIXLY_CORRECT-unset}"; shopt -p expand_aliases inherit_errexit shift_verbose
  => unset | shopt -u expand_aliases | shopt -u inherit_errexit | shopt -u shift_verbose |   reached, status 1
on
off
on from the environment
alias hi="echo alias expanded"
hi
  => alias expanded |   reached, status 0
=== special builtins
x=1 :; echo "x=$x"; declare -p x
  => x=1 | declare -x x="1" |   reached, status 0
y=1 true; echo "y=${y-unset}"
  => y=unset |   reached, status 0
set() { echo function; }; echo not reached
  => wbsh: line 1: `set': is a special builtin
export() { echo function; }
  => wbsh: line 1: `export': is a special builtin
eval() { echo function; }
  => wbsh: line 1: `eval': is a special builtin
f-1() { echo dash name; }; f-1
  => dash name |   reached, status 0
export "a b"; echo not reached
  => wbsh: line 1: export: `a b': not a valid identifier
readonly r=1; export r=2; echo not reached
  => wbsh: line 1: r: readonly variable
unset "a b"; echo not reached
  => not reached |   reached, status 0
set -o nosuch; echo not reached
  => wbsh: line 1: set: nosuch: invalid option name
shift 5; echo not reached
  => wbsh: line 1: shift: 5: shift count out of range
trap "" NOSIG; echo not reached
  => wbsh: line 1: trap: NOSIG: invalid signal specification | not reached |   reached, status 0
eval "("; echo not reached
  => wbsh: eval: line 2: syntax error: unexpected end of file from `(' command on line 1
command eval "("; echo "after command eval $?"
  => wbsh: eval: line 2: syntax error: unexpected end of file from `(' command on line 1 | after command eval 2 |   reached, status 0
. ./_no_such_file; echo not reached
  => wbsh: line 1: ./_no_such_file: No such file or directory
command . ./_no_such_file; echo "after command . $?"
  => wbsh: line 1: ./_no_such_file: No such file or directory | after command . 1 |   reached, status 0
eval "false"; echo "eval of false is fine $?"
  => eval of false is fine 1 |   reached, status 0
readonly r=1; r=2; echo not reached
  => wbsh: line 1: r: readonly variable
readonly r=1; r=2 :; echo not reached
  => wbsh: line 1: r: readonly variable
readonly r=1; r=2 echo not run; echo "after prefix error $?"
  => wbsh: line 1: r: readonly variable | after prefix error 1 |   reached, status 0
echo $((1 +)); echo not reached
