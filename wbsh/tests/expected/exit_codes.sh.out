=== 1. process exit codes keep their low byte
0 -> 0
1 -> 1
255 -> 255
256 -> 0
300 -> 44
511 -> 255
-1 -> 255
-2 -> 254
-256 -> 0
=== 2. crash and Ctrl+C codes become 128 + signal
-1073741510 -> 130
-1073741819 -> 139
-1073741571 -> 139
-1073741795 -> 132
-1073741676 -> 136
-1073740791 -> 134
=== 3. pipelines
last stage -> 0
last stage native -> 44
pipefail -> 44
=== 4. wait
wait pid -> 44
wait ctrl-c -> 130
=== 5. exit and return operands
exit 300 -> 44
exit -1 -> 255
exit 256 -> 0
return 257 -> 1
return -2 -> 254
