=== 2. >&N and <&N from a closed fd fail the command
echo x >&7 -> rc=1 error=7: Bad file descriptor
echo y 2>&7 -> rc=1 error=7: Bad file descriptor
cat <&8 -> rc=1 error=8: Bad file descriptor
{ echo inner >&3; } >/dev/null -> rc=1 error=3: Bad file descriptor
x=$(echo sub >&3) -> rc=1 error=3: Bad file descriptor
exec 4>&1; exec 4>&-; echo closed4 >&4 -> rc=1 error=4: Bad file descriptor
|| runs after the failure
