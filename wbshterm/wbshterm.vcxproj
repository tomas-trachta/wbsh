  <!-- Built alongside wbsh.exe so the spike's default shell lookup (see
       locateShell in src\spike_main.cpp) finds it next to itself. The
       binary keeps the -spike suffix until M1 replaces the passthrough
       with a real window; wbshterm\build.ps1 builds the same sources
       without Visual Studio and must stay flag-compatible with this. -->
  <PropertyGroup>
    <TargetName>wbshterm-spike</TargetName>
    <OutDir>$(ProjectDir)..\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(ProjectDir)build\msbuild\$(Platform)\$(Configuration)\</IntDir>
  </PropertyGroup>

