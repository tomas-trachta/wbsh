// Application icon. The lowest-numbered ICON resource is what Explorer,
// the taskbar and Alt-Tab pick up, so this stays as id 1.
1 ICON "..\\..\\installer\\wbshterm.ico"

// VERSIONINFO, built from the same WBSH_VERSION_* defines wbsh uses. Both
// projects import version.props, so the shell and the terminal always
// report the same version -- which is what the startup panel shows.
#include <winver.h>

#define WBSHTERM_VSTR_(x) #x
#define WBSHTERM_VSTR(x)  WBSHTERM_VSTR_(x)
#define WBSHTERM_VERSION_STR \
    WBSHTERM_VSTR(WBSH_VERSION_MAJOR) "." \
    WBSHTERM_VSTR(WBSH_VERSION_MINOR) "." \
    WBSHTERM_VSTR(WBSH_VERSION_PATCH)

VS_VERSION_INFO VERSIONINFO
FILEVERSION    WBSH_VERSION_MAJOR,WBSH_VERSION_MINOR,WBSH_VERSION_PATCH,0
PRODUCTVERSION WBSH_VERSION_MAJOR,WBSH_VERSION_MINOR,WBSH_VERSION_PATCH,0
FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
FILEFLAGS      0x0L
FILEOS         VOS__WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 040904b0 = lang 0x0409 (en-US), charset 0x04b0 (Unicode).
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Tomas Trachta"
            VALUE "FileDescription",  "Terminal for wbsh"
            VALUE "FileVersion",      WBSHTERM_VERSION_STR
            VALUE "InternalName",     "wbshterm"
            VALUE "LegalCopyright",   "MIT License (c) 2026 Tomas Trachta"
            VALUE "OriginalFilename", "wbshterm.exe"
            VALUE "ProductName",      "wbshterm"
            VALUE "ProductVersion",   WBSHTERM_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04b0
    END
END
