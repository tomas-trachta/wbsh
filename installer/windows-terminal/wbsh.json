// Windows Terminal fragment extension for wbsh.
//
// The installer's "Add a wbsh profile to Windows Terminal" task copies it to
//   %LOCALAPPDATA%\Microsoft\Windows Terminal\Fragments\wbsh\wbsh.json
// where both the Store and the unpackaged Windows Terminal merge it on their
// next start, without touching settings.json. A manual install copies it
// there by hand.
//
// WT then shows a "wbsh" entry in the new-tab dropdown that launches
// `%LOCALAPPDATA%\Programs\wbsh\wbsh.exe` (the installer's default folder;
// the installer writes another folder in when one was chosen) under the
// bundled `wbsh` colour scheme. Keep this file ASCII: the installer rewrites
// it byte for byte.
{
    "$schema": "https://aka.ms/terminal-profiles-schema",

    "profiles": [
        {
            "name": "wbsh",
            "guid": "{c4b9d2e1-7a3f-4d8c-b5e6-9f2a1c0d4e7b}",
            "commandline": "%LOCALAPPDATA%\\Programs\\wbsh\\wbsh.exe -i",
            "icon": "%LOCALAPPDATA%\\Programs\\wbsh\\wbsh.exe",
            "startingDirectory": "%USERPROFILE%",
            "hidden": false,
            "tabTitle": "wbsh",
            "font": {
                "face": "Cascadia Code"
            },
            "colorScheme": "wbsh",
            "cursorShape": "bar",
            "antialiasingMode": "cleartype"
        }
    ],

    "schemes": [
        {
            "name": "wbsh",
            "background": "#1A1B26",
            "foreground": "#C0CAF5",
            "cursorColor": "#C0CAF5",
            "selectionBackground": "#283457",

            "black":         "#15161E",
            "red":           "#F7768E",
            "green":         "#9ECE6A",
            "yellow":        "#E0AF68",
            "blue":          "#7AA2F7",
            "purple":        "#BB9AF7",
            "cyan":          "#7DCFFF",
            "white":         "#A9B1D6",

            "brightBlack":   "#414868",
            "brightRed":     "#F7768E",
            "brightGreen":   "#9ECE6A",
            "brightYellow":  "#E0AF68",
            "brightBlue":    "#7AA2F7",
            "brightPurple":  "#BB9AF7",
            "brightCyan":    "#7DCFFF",
            "brightWhite":   "#C0CAF5"
        }
    ]
}
